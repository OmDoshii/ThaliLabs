---
import Base from '../../layouts/Base.astro';
import FoodCalc from '../../components/FoodCalc.tsx';
import { foodTitle } from '../../components/FoodLabel.tsx';
import { getFoodBySlug, listFoods } from '../../lib/db.ts';
export const prerender = false;

const { slug } = Astro.params;
const food = slug ? await getFoodBySlug(Astro.locals, slug) : null;
if (!food) return new Response('Not found', { status: 404 });

const title = foodTitle(food);
const related = (await listFoods(Astro.locals, { category: food.category, limit: 8 })).filter((f) => f.id !== food.id).slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NutritionInformation',
  name: `${title} nutrition per 100g`,
  servingSize: '100 g',
  calories: `${food.kcal} kcal`,
  proteinContent: `${food.protein} g`,
  carbohydrateContent: `${food.carbs} g`,
  fatContent: `${food.fat} g`,
  ...(food.fibre != null && { fiberContent: `${food.fibre} g` }),
  ...(food.sugar != null && { sugarContent: `${food.sugar} g` }),
};
// Low-quality or unchecked rows should not be indexed
const noindex = food.status === 'flagged';
---
<Base
  title={`${title} calories and macros per 100g | Thali Labs`}
  description={`${title}: ${food.kcal} kcal, ${food.protein}g protein, ${food.carbs}g carbs, ${food.fat}g fat per 100g. Enter your amount for exact numbers.`}
  jsonLd={jsonLd} noindex={noindex} canonicalPath={`/nutrition/${food.slug}`}
>
  <div class="mx-auto max-w-3xl px-5 py-10">
    <nav class="text-sm text-muted" aria-label="Breadcrumb"><a class="underline" href="/nutrition">Food database</a> / {food.category.replace(/-/g, ' ')}</nav>
    <h1 class="display mt-3 text-5xl sm:text-6xl">{title} calories</h1>
    <p class="mt-3 text-lg">
      <strong>{food.kcal} kcal</strong> per 100g, with {food.protein}g protein, {food.carbs}g carbs and {food.fat}g fat.
      Change the amount below to see your portion.
    </p>
    <div class="mt-8"><FoodCalc client:load food={food} /></div>

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="display text-2xl">More {food.category.replace(/-/g, ' ')}</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {related.map((r) => (
            <li><a class="flex justify-between rounded-md border-2 border-navy bg-paper px-3 py-2 hover:bg-chalk" href={`/nutrition/${r.slug}`}>
              <span class="font-semibold">{foodTitle(r)}</span><span class="display-num text-muted">{r.kcal} kcal</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
