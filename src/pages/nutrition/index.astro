---
import Base from '../../layouts/Base.astro';
import { listFoods } from '../../lib/db.ts';
import { foodTitle } from '../../components/FoodLabel.tsx';
export const prerender = false;

const foods = (await listFoods(Astro.locals, { limit: 1000 })).filter((f) => f.status !== 'flagged' || f.is_generic);
const groups = new Map<string, typeof foods>();
for (const f of foods) groups.set(f.category, [...(groups.get(f.category) ?? []), f]);
const cats = [...groups.keys()].sort();
---
<Base title="Indian food calorie database | Thali Labs" description="Calories and macros per 100g for Indian foods and packaged brands.">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <h1 class="display text-5xl sm:text-6xl">Food database</h1>
    <p class="mt-3 max-w-xl text-muted">{foods.length} foods. Values are per 100g. Open any food to enter your own amount.</p>
    <nav class="mt-5 flex flex-wrap gap-2" aria-label="Categories">
      {cats.map((c) => <a href={`#${c}`} class="rounded-sm bg-ultramarine px-2.5 py-1 text-sm font-semibold capitalize text-white hover:bg-ultramarine-deep">{c.replace(/-/g, ' ')}</a>)}
    </nav>
    {cats.map((c) => (
      <section id={c} class="mt-10 scroll-mt-4">
        <h2 class="display text-3xl capitalize">{c.replace(/-/g, ' ')}</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {groups.get(c)!.map((f) => (
            <li><a href={`/nutrition/${f.slug}`} class="flex items-baseline justify-between gap-2 rounded-md border-2 border-navy bg-paper px-3 py-2 hover:bg-chalk">
              <span class="font-semibold">{foodTitle(f)}</span><span class="display-num text-muted">{Math.round(f.kcal)}</span></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
