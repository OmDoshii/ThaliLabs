---
import Base from '../layouts/Base.astro';
import Logger from '../components/Logger.tsx';

export const prerender = true;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Thali Labs Calorie Counter',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any',
  description: 'Brand-wise calorie and macro counter for Indian foods.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
};
---
<Base title="Brand-wise Indian calorie counter | Thali Labs" jsonLd={jsonLd}>
  <section class="bg-ultramarine text-white">
    <div class="mx-auto max-w-6xl px-5 pb-14 pt-10 sm:pt-14">
      <h1 class="display max-w-3xl text-5xl sm:text-7xl">
        Not all paneer is the same paneer.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-white/85">
        Pick the exact brand, type the amount, and get calories and macros from the label on the pack. Works for dal, dahi, whey and everything in between.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">
        <li class="rounded-sm bg-white/15 px-2.5 py-1">Brand and variant</li>
        <li class="rounded-sm bg-white/15 px-2.5 py-1">Grams, pieces or scoops</li>
        <li class="rounded-sm bg-white/15 px-2.5 py-1">Raw or cooked</li>
        <li class="rounded-sm bg-white/15 px-2.5 py-1">No sign-up</li>
      </ul>
    </div>
    <div class="h-3 bg-marigold"></div>
  </section>

  <div class="mx-auto max-w-6xl px-5 py-10">
    <Logger client:load />
  </div>
</Base>
